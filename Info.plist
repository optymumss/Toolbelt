<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleExecutable</key>
    <string>Toolbelt</string>
    <key>CFBundleIdentifier</key>
    <string>local.personal.toolbelt</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>Toolbelt</string>
    <key>CFBundleDisplayName</key>
    <string>Toolbelt</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>NSBluetoothAlwaysUsageDescription</key>
    <string>Toolbelt notices Bluetooth devices connecting and disconnecting, for macros you set up to start then.</string>
    <key>CFBundleShortVersionString</key>
    <string>0.29</string>
    <key>CFBundleVersion</key>
    <string>29</string>
    <key>LSMinimumSystemVersion</key>
    <string>14.0</string>
    <key>NSAppleEventsUsageDescription</key>
    <string>Toolbelt asks Finder, System Events and the login window to empty the Bin, switch dark mode, restart, shut down or log out when you choose those commands.</string>
    <key>NSLocationUsageDescription</key>
    <string>macOS only tells apps the name of your Wi-Fi network if they may use Location Services. Toolbelt uses it only for macros that start when you join a particular Wi-Fi network.</string>
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>macOS only tells apps the name of your Wi-Fi network if they may use Location Services. Toolbelt uses it only for macros that start when you join a particular Wi-Fi network.</string>
    <key>NSAppTransportSecurity</key>
    <dict>
        <!-- The download manager must be able to fetch plain http:// links too. -->
        <key>NSAllowsArbitraryLoads</key>
        <true/>
    </dict>
    <key>NSServices</key>
    <array>
        <dict>
            <key>NSMenuItem</key><dict><key>default</key><string>Add to Toolbelt Shelf</string></dict>
            <key>NSMessage</key><string>addToShelf</string>
            <key>NSPortName</key><string>Toolbelt</string>
            <key>NSSendTypes</key><array><string>public.file-url</string><string>public.utf8-plain-text</string><string>public.url</string></array>
            <key>NSSendFileTypes</key><array><string>public.item</string></array>
            <key>NSRequiredContext</key><dict/>
        </dict>
        <dict>
            <key>NSMenuItem</key><dict><key>default</key><string>Download with Toolbelt</string></dict>
            <key>NSMessage</key><string>downloadLink</string>
            <key>NSPortName</key><string>Toolbelt</string>
            <key>NSSendTypes</key><array><string>public.utf8-plain-text</string><string>public.url</string></array>
            
            <key>NSRequiredContext</key><dict/>
        </dict>
        <dict>
            <key>NSMenuItem</key><dict><key>default</key><string>Save as Toolbelt Snippet</string></dict>
            <key>NSMessage</key><string>saveSnippet</string>
            <key>NSPortName</key><string>Toolbelt</string>
            <key>NSSendTypes</key><array><string>public.utf8-plain-text</string></array>
            
            <key>NSRequiredContext</key><dict/>
        </dict>
        <dict>
            <key>NSMenuItem</key><dict><key>default</key><string>Pin in Toolbelt Clipboard</string></dict>
            <key>NSMessage</key><string>pinInClipboard</string>
            <key>NSPortName</key><string>Toolbelt</string>
            <key>NSSendTypes</key><array><string>public.utf8-plain-text</string><string>public.file-url</string></array>
            <key>NSSendFileTypes</key><array><string>public.item</string></array>
            <key>NSRequiredContext</key><dict/>
        </dict>
    </array>
    <key>LSUIElement</key>
    <true/>
    <key>NSHighResolutionCapable</key>
    <true/>
</dict>
</plist>
