{
  "manifest_version": 3,
  "name": "Toolbelt Downloads",
  "version": "1.1",
  "description": "Hands your downloads to Toolbelt's download manager on this Mac, and adds a download button, with a choice of sizes, to videos that allow it.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": ["downloads", "nativeMessaging", "contextMenus", "cookies", "storage", "webRequest"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Toolbelt Downloads", "default_popup": "popup.html" },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["video.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
